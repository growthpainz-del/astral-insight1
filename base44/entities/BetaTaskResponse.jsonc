{
  "name": "BetaTaskResponse",
  "properties": {
    "active_session_seconds": {
      "description": "Active engaged time in-app before this response, pause-aware via visibilitychange",
      "type": "number"
    },
    "note": {
      "description": "Optional short note from the tester",
      "type": "string"
    },
    "result": {
      "description": "One-tap outcome",
      "enum": [
        "worked",
        "broken",
        "confusing"
      ],
      "type": "string"
    },
    "task_id": {
      "description": "References BetaTask.id",
      "type": "string"
    },
    "tester_email": {
      "description": "Auto-captured from logged-in tester",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "result"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tester_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tester_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tester_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}