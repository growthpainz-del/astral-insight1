{
  "name": "ReportedContent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    },
    "type": {
      "type": "string",
      "enum": [
        "reading_interpretation",
        "chat_message",
        "generated_image",
        "other"
      ],
      "description": "The type of content being reported"
    },
    "context": {
      "type": "string",
      "description": "The content itself, URL, or context of the report"
    },
    "reason": {
      "type": "string",
      "description": "User's reason for reporting the content"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending",
      "description": "Admin review status"
    }
  },
  "required": [
    "type",
    "context",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}