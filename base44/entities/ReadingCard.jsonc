{
  "name": "ReadingCard",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    },
    "session_id": {
      "type": "string",
      "description": "References ReadingSession.id"
    },
    "position_key": {
      "type": "string",
      "description": "e.g. 'inner_ring_2', 'past', 'center'"
    },
    "card_id": {
      "type": "string",
      "description": "References your oracle deck JSON / card ID"
    },
    "revealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reader_note": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "position_key",
    "card_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}